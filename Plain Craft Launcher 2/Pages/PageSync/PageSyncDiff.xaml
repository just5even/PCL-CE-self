<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:PCL"
    mc:Ignorable="d"
    x:Class="PCL.PageSyncDiff"
    d:DesignWidth="800" d:DesignHeight="600">
    <Grid>
        <local:MyScrollViewer x:Name="PanContent">
            <StackPanel Margin="10">
                <!-- Summary header -->
                <local:MyCard Margin="10" x:Name="CardSummary">
                    <StackPanel Margin="20,15">
                        <TextBlock x:Name="TxtSummary" FontSize="18" TextWrapping="Wrap"
                                   Text="检测到实例变更"/>
                        <TextBlock x:Name="TxtDetail" FontSize="14" Margin="0,8,0,0"
                                   Foreground="{StaticResource ColorBrushGray3}" TextWrapping="Wrap"
                                   Text=""/>
                    </StackPanel>
                </local:MyCard>

                <!-- Diff list -->
                <local:MyCard Title="变更列表" Margin="10">
                    <StackPanel x:Name="StackDiffList" Margin="15,10">
                        <!-- Entries added dynamically in code-behind -->
                    </StackPanel>
                </local:MyCard>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                    <local:MyTextButton x:Name="BtnSyncNow" Text="开始同步" Margin="5"
                                        Click="BtnSyncNow_Click"/>
                    <local:MyTextButton x:Name="BtnCancel" Text="取消" Margin="5"
                                        Click="BtnCancel_Click"/>
                </StackPanel>

                <!-- Progress -->
                <local:MyCard Title="同步进度" Margin="10" x:Name="CardProgress" Visibility="Collapsed">
                    <StackPanel Margin="15,10">
                        <ProgressBar x:Name="ProgSync" Height="8" IsIndeterminate="False" Margin="0,5"/>
                        <TextBlock x:Name="TxtProgress" FontSize="14" Text="准备中..."
                                   Foreground="{StaticResource ColorBrushGray3}" TextWrapping="Wrap"/>
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>
    </Grid>
</local:MyPageRight>
